# Kopieer naar .env en pas aan. Wordt door start.sh ingelezen.

# Verplicht voor beleefd gebruik van OpenStreetMap (Nominatim): echt e-mailadres
LEADFINDER_CONTACT=jelle.stifter2007@gmail.com

# Waar het dashboard luistert. Leeg = Tailscale-IP indien aanwezig, anders 127.0.0.1.
# 0.0.0.0 = bereikbaar voor je hele netwerk (het dashboard heeft GEEN login!)
#LEADFINDER_BIND=
#LEADFINDER_PORT=8501

# Zoekstraal rond het stadscentrum, in meters
#LEADFINDER_RADIUS=6000

# Eigen Overpass-servers (komma-gescheiden), in volgorde van voorkeur
#LEADFINDER_OVERPASS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
